{
  "name": "mdsilo-app",
  "version": "0.7.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "homepage": "https://mdsilo.com",
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 3000",
    "build": "pnpm --filter mdsmirror build && vite build",
    "start:web": "vite --config vite.web.config.mts --host 0.0.0.0",
    "build:web": "pnpm --filter mdsmirror build && vite build --config vite.web.config.mts",
    "preview:web": "vite preview --config vite.web.config.mts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src && pnpm --filter mdsmirror lint",
    "lint-ignore": "pnpm lint || true",
    "fix": "prettier --write src",
    "tc": "pnpm --filter mdsmirror build && tsc",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.10",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@popperjs/core": "^2.11.8",
    "@react-spring/web": "^10.1.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "codemirror": "^6.0.2",
    "copy-to-clipboard": "^4.0.2",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "daisyui": "^5.7.50",
    "dompurify": "^3.4.17",
    "fuse.js": "^7.5.0",
    "html2canvas": "1.4.1",
    "immer": "^11.2.9",
    "is-hotkey": "^0.2.0",
    "jspdf": "^4.2.1",
    "markmap-common": "^0.18.9",
    "markmap-lib": "0.18.12",
    "markmap-view": "0.18.12",
    "mdsmirror": "workspace:*",
    "prosemirror-utils": "^1.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-highlight-words": "^1.0.0",
    "react-icons": "=5.7.0",
    "react-popper": "^2.3.0",
    "react-virtual": "^2.10.4",
    "react-virtualized": "^10.0.0",
    "react-virtualized-auto-sizer": "^1.0.26",
    "styled-components": "^6.6.0",
    "tailwindcss": "^4.3.3",
    "tippy.js": "^6.3.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
