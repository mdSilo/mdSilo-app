    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-testing-library": "^7.13.3",
    "fake-indexeddb": "^6",
    "jsdom": "^25.0.1",
    "postcss": "8.4.22",
    "prettier": "2.7.1",
    "typescript": "5.9.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "pnpm@10.28.2"
}
